---
/**
 * FxBadge — 实时 USD/CNY 外汇徽章
 * 客户端 fetch，5 分钟 localStorage 缓存，失败 fallback。
 */
---
<div
  id="fx-badge"
  class="ln-fx"
  data-pair="USD/CNY"
  data-fallback-value="7.24"
  data-fallback-date="2026-01-15"
  title="数据来源：Frankfurter / 欧洲央行参考汇率"
>
  <span class="ln-fx-pair">USD/CNY</span>
  <span class="ln-fx-value" id="fx-value">—</span>
  <span class="ln-fx-meta" id="fx-meta">加载中…</span>
</div>

<style>
  .ln-fx {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 42px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(12px);
    font-size: 13px;
    font-weight: 600;
    color: var(--fg, #e6edf3);
    white-space: nowrap;
    cursor: default;
    transition: background 0.15s ease, border-color 0.15s ease;
    flex: 0 0 auto;
  }
  :root:not(.dark) .ln-fx {
    background: rgba(10, 12, 16, 0.03);
  }
  .ln-fx:hover {
    border-color: rgba(42, 160, 255, 0.4);
    background: rgba(42, 160, 255, 0.08);
  }
  .ln-fx-pair {
    color: var(--muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
  }
  .ln-fx-value {
    font-variant-numeric: tabular-nums;
    font-size: 14px;
    font-weight: 800;
    color: var(--fg, #e6edf3);
  }
  .ln-fx-meta {
    font-size: 10px;
    color: var(--muted);
    font-weight: 500;
  }
  .ln-fx.is-up .ln-fx-value::before {
    content: "↑ ";
    color: #ef6c4d;
  }
  .ln-fx.is-down .ln-fx-value::before {
    content: "↓ ";
    color: #4caf50;
  }
  .ln-fx.is-offline .ln-fx-value {
    color: var(--muted);
  }
  .ln-fx.is-offline .ln-fx-meta::after {
    content: " (离线)";
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .ln-fx {
      height: 40px;
      padding: 0 12px;
      gap: 6px;
    }
    .ln-fx-meta {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    const badge = document.getElementById("fx-badge");
    if (!badge) return;

    const valueEl = document.getElementById("fx-value");
    const metaEl = document.getElementById("fx-meta");
    const CACHE_KEY = "ln_fx_usd_cny_v1";
    const CACHE_TTL = 5 * 60 * 1000; // 5 分钟
    const FALLBACK_VALUE = badge.dataset.fallbackValue;
    const FALLBACK_DATE = badge.dataset.fallbackDate;

    function fmtDate(iso) {
      try {
        const d = new Date(iso);
        return d.toISOString().slice(0, 10);
      } catch {
        return FALLBACK_DATE;
      }
    }

    function render(value, date, status) {
      valueEl.textContent = value;
      metaEl.textContent = "· " + date;
      badge.classList.remove("is-up", "is-down", "is-offline");
      if (status === "up") badge.classList.add("is-up");
      else if (status === "down") badge.classList.add("is-down");
      else if (status === "offline") badge.classList.add("is-offline");
    }

    // 1. 尝试读缓存
    let cached = null;
    try {
      const raw = localStorage.getItem(CACHE_KEY);
      if (raw) {
        const obj = JSON.parse(raw);
        if (obj && obj.value && Date.now() - obj.ts < CACHE_TTL) {
          cached = obj;
          render(obj.value, obj.date, obj.status);
        }
      }
    } catch (e) {}

    // 2. fetch 实时数据（不论有没有缓存，都拉一次）
    fetch("https://api.frankfurter.app/latest?from=USD&to=CNY")
      .then((r) => (r.ok ? r.json() : Promise.reject(r.statusText)))
      .then((d) => {
        const v = Number(d.rates.CNY).toFixed(2);
        const date = fmtDate(d.date);
        const status = "up"; // 拉取成功默认显示中性偏积极
        render(v, date, status);
        try {
          localStorage.setItem(
            CACHE_KEY,
            JSON.stringify({ value: v, date, status, ts: Date.now() })
          );
        } catch (e) {}
      })
      .catch(() => {
        // 3. fallback：缓存优先，没有就用 fallback 值
        if (cached) return; // 已经有缓存，保持显示
        render(FALLBACK_VALUE, FALLBACK_DATE, "offline");
      });
  })();
</script>
