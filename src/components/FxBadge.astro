---
/**
 * FxBadge — 实时 USD/CNY 外汇徽章
 * 客户端 fetch，5 分钟 localStorage 缓存，失败 fallback。
 * 多 API 备用，国内友好。
 */
---
<div
  id="fx-badge"
  class="ln-fx"
  data-pair="USD/CNY"
  data-fallback-value="7.24"
  title="数据来源：欧洲央行 / 美联储参考汇率"
>
  <span class="ln-fx-pair">USD/CNY</span>
  <span class="ln-fx-value" id="fx-value">—</span>
  <span class="ln-fx-meta" id="fx-meta">加载中…</span>
</div>

<style>
  .ln-fx {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 42px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(12px);
    font-size: 13px;
    font-weight: 600;
    color: var(--fg, #e6edf3);
    white-space: nowrap;
    cursor: default;
    transition: background 0.15s ease, border-color 0.15s ease;
    flex: 0 0 auto;
  }
  :root:not(.dark) .ln-fx {
    background: rgba(10, 12, 16, 0.03);
  }
  .ln-fx:hover {
    border-color: rgba(42, 160, 255, 0.4);
    background: rgba(42, 160, 255, 0.08);
  }
  .ln-fx-pair {
    color: var(--muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
  }
  .ln-fx-value {
    font-variant-numeric: tabular-nums;
    font-size: 14px;
    font-weight: 800;
    color: var(--fg, #e6edf3);
  }
  .ln-fx-meta {
    font-size: 10px;
    color: var(--muted);
    font-weight: 500;
  }
  .ln-fx.is-up .ln-fx-value::before {
    content: "↑ ";
    color: #ef6c4d;
  }
  .ln-fx.is-down .ln-fx-value::before {
    content: "↓ ";
    color: #4caf50;
  }
  .ln-fx.is-offline .ln-fx-value {
    color: var(--muted);
  }
  .ln-fx.is-offline .ln-fx-meta::after {
    content: " (离线)";
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .ln-fx {
      height: 40px;
      padding: 0 12px;
      gap: 6px;
    }
    .ln-fx-meta {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    function initFxBadge() {
      var badge = document.getElementById("fx-badge");
      if (!badge) return;

      var valueEl = document.getElementById("fx-value");
      var metaEl = document.getElementById("fx-meta");
      var CACHE_KEY = "ln_fx_usd_cny_v2";
      var CACHE_TTL = 5 * 60 * 1000;
      var FALLBACK_VALUE = badge.dataset.fallbackValue || "7.24";

      function getTodayStr() {
        return new Date().toISOString().slice(0, 10);
      }

      function fmtDate(iso) {
        try {
          var d = new Date(iso);
          if (isNaN(d.getTime())) return getTodayStr();
          return d.toISOString().slice(0, 10);
        } catch (e) {
          return getTodayStr();
        }
      }

      function render(value, date, status) {
        valueEl.textContent = value;
        metaEl.textContent = "· " + date;
        badge.classList.remove("is-up", "is-down", "is-offline");
        if (status === "up") badge.classList.add("is-up");
        else if (status === "down") badge.classList.add("is-down");
        else if (status === "offline") badge.classList.add("is-offline");
      }

      // 尝试读缓存
      var cached = null;
      try {
        var raw = localStorage.getItem(CACHE_KEY);
        if (raw) {
          var obj = JSON.parse(raw);
          if (obj && obj.value && Date.now() - obj.ts < CACHE_TTL) {
            cached = obj;
            render(obj.value, obj.date, obj.status);
          }
        }
      } catch (e) {}

      // API 列表
      var API_LIST = [
        {
          url: "https://api.frankfurter.app/latest?from=USD&to=CNY",
          parse: function (d) {
            return { value: Number(d.rates.CNY).toFixed(2), date: d.date };
          },
        },
        {
          url: "https://open.er-api.com/v6/latest/USD",
          parse: function (d) {
            return { value: Number(d.rates.CNY).toFixed(2), date: d.time_last_update_utc };
          },
        },
        {
          url: "https://api.exchangerate.host/latest?base=USD&symbols=CNY",
          parse: function (d) {
            return { value: Number(d.rates.CNY).toFixed(2), date: d.date };
          },
        },
      ];

      var apiIndex = 0;

      function tryNextApi() {
        if (apiIndex >= API_LIST.length) {
          if (cached) return;
          render(FALLBACK_VALUE, getTodayStr(), "offline");
          return;
        }

        var api = API_LIST[apiIndex++];
        fetch(api.url)
          .then(function (r) {
            if (!r.ok) throw new Error("HTTP " + r.status);
            return r.json();
          })
          .then(function (d) {
            var result = api.parse(d);
            if (!result.value || isNaN(parseFloat(result.value))) {
              throw new Error("Invalid rate");
            }
            var date = fmtDate(result.date);
            var status = "up";
            render(result.value, date, status);
            try {
              localStorage.setItem(
                CACHE_KEY,
                JSON.stringify({ value: result.value, date: date, status: status, ts: Date.now() })
              );
            } catch (e) {}
          })
          .catch(function () {
            tryNextApi();
          });
      }

      tryNextApi();
    }

    // 确保 DOM 加载完成后执行
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initFxBadge);
    } else {
      initFxBadge();
    }
  })();
</script>
