---
/*
 * NewsletterSubscribe — 简单的邮件订阅入口
 * 集成 Buttondown / Mailchimp 等服务的嵌入表单
 * 若无后端服务，显示"关注我们"引导
 */
import { SITE_TITLE } from "../consts";

export interface Props {
  /** 表单 action URL（Buttondown / Mailchimp 等） */
  action?: string;
  /** 隐藏标题行 */
  compact?: boolean;
}

const { action = "", compact = false } = Astro.props;
---

{action ? (
  <section class="ln-newsletter" aria-label="邮件订阅">
    {!compact && (
      <div class="ln-newsletter-head">
        <span class="ln-newsletter-icon">📬</span>
        <div>
          <div class="ln-newsletter-title">订阅更新</div>
          <p class="ln-newsletter-desc">新文章第一时间送达，不打扰，不收费。</p>
        </div>
      </div>
    )}
    <form class="ln-newsletter-form" action={action} method="post" target="_blank" rel="noopener">
      <input
        class="ln-newsletter-input"
        type="email"
        name="email"
        placeholder="输入邮箱地址"
        required
        autocomplete="email"
      />
      <button class="ln-newsletter-btn" type="submit">订阅</button>
    </form>
  </section>
) : (
  <section class="ln-newsletter ln-newsletter--follow" aria-label="关注我们">
    {!compact && (
      <div class="ln-newsletter-head">
        <span class="ln-newsletter-icon">📬</span>
        <div>
          <div class="ln-newsletter-title">获取最新外贸干货</div>
          <p class="ln-newsletter-desc">关注 {SITE_TITLE}，第一时间获取客户开发、数据分析、自动化营销实战内容。</p>
        </div>
      </div>
    )}
    <div class="ln-newsletter-actions">
      <a class="ln-newsletter-btn" href="/rss.xml" target="_blank" rel="noopener">RSS 订阅</a>
      <a class="ln-newsletter-btn ln-newsletter-btn--outline" href="/" rel="noopener">浏览全部文章</a>
    </div>
  </section>
)}
