---
import "../styles/linear.css";
import SeoHead from "../components/SeoHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { SITE_TITLE, SITE_URL } from "../consts";

export const prerender = true;

const pageTitle = `客户开发报告：美国灯具进口商分析 | ${SITE_TITLE}`;
const pageDescription = "美国灯具（HS 9405）进口市场分析与开发方案：市场规模、头部采购商 Top 10、供应国竞争格局、旺季节奏与可直接开发的中国→美国买家名单。";
const canonicalURL = new URL("/customer-report", SITE_URL).toString();
const pageImage = new URL("/og/customer-report.png", SITE_URL).toString();

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE_TITLE, item: SITE_URL },
    { "@type": "ListItem", position: 2, name: "客户开发报告", item: canonicalURL },
    { "@type": "ListItem", position: 3, name: "美国灯具进口商分析", item: canonicalURL },
  ],
};

const datasetSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "美国灯具（HS 9405）进口市场分析与开发方案",
  description: pageDescription,
  url: canonicalURL,
  dateCreated: "2026-08-05",
  creator: { "@type": "Organization", name: SITE_TITLE, url: SITE_URL },
  about: "US lighting imports HS 9405",
};

const topBuyers = [
  ["1", "NEW BRIGHT TECHNOLOGY (MACAO) LIMITED", "13,608", "4.23%", "澳门离岸采购"],
  ["2", "HONGKONG SNC LIGHTING CO., LIMITED", "12,475", "3.87%", "香港离岸采购"],
  ["3", "ELEC-TECH SOLID STATE LIGHTING(HK) LTD", "10,577", "3.29%", "香港离岸采购"],
  ["4", "WAYSPRIDE CHINA LIMITED", "9,089", "2.82%", "香港离岸采购"],
  ["5", "SUPERIOR LITE CORPORATION LIMITED", "6,887", "2.14%", "香港离岸采购"],
  ["6", "LG SOURCING, INC", "6,242", "1.94%", "LG 美国采购公司"],
  ["7", "HOME DEPOT, U. S. A., INC", "5,375", "1.67%", "家得宝 · 美国本土终端"],
  ["8", "HONG KONG HAO KANG ELECTRONIC CO., LTD", "4,187", "1.30%", "香港离岸采购"],
  ["9", "EVER WAVE CO.,LTD", "4,041", "1.26%", "香港离岸采购"],
  ["10", "ELIM COMPANY LIMITED", "3,840", "1.19%", "香港离岸采购"],
];

const supplyCountries = [
  ["越南 vn", "215,219", "66.84%", "1,516"],
  ["中国 cn", "52,127", "16.19%", "9,283"],
  ["香港 hk", "26,918", "8.36%", "786"],
  ["泰国 th", "3,274", "1.02%", "233"],
  ["印度 in", "3,075", "0.96%", "491"],
];

const hotBuyers = [
  ["SIGNIFY NORTH AMERICA CORP", "LED 灯泡", "昕诺飞/飞利浦北美，大客户"],
  ["THE UTTERMOST CO", "树脂/铁/陶瓷台灯", "美国家居品牌"],
  ["MCGEE CO PARTNER LLC", "吊灯/壁灯/灯罩", "美国家居品牌"],
  ["FANGIO LIGHTING", "陶瓷台灯", "灯具进口商"],
  ["MASLA INC", "吊灯", "灯具进口商"],
  ["BIOLUZ LED", "LED 灯", "专业 LED 商"],
  ["ARCHIOLOGY INC", "灯具", "家居进口商"],
  ["THUNDER NORTH AMERICAN TRADE INC", "LED 灯具/灯泡", "贸易商"],
  ["GLOBALROOT INC", "装饰灯", "装饰灯商"],
  ["NAVARO INC", "LED 灯存储盒", "贸易商"],
  ["ULIGHTING TRADE LTD INC", "LED 灯带", "贸易商"],
  ["JOHN A STEER & CO", "LED 台灯", "贸易商"],
  ["FUTURE TRADING INC", "灯具", "贸易商"],
  ["HONGKONG HENGMEIRUI TRADING", "圣诞灯串", "港资贸易"],
];
---

<html lang="zh-CN">
  <head>
    <SeoHead
      title={pageTitle}
      description={pageDescription}
      canonical={canonicalURL}
      image={pageImage}
      includeRss={false}
      structuredData={{
        "@context": "https://schema.org",
        "@graph": [breadcrumbSchema, datasetSchema],
      }}
    />
  </head>

  <body class="ln ln-home ln-report">
    <div class="ln-bg-floor" aria-hidden="true"></div>
    <SiteHeader active="customer-report" />

    <main class="ln-wrap">
      <!-- 报告头部 -->
      <section class="cr-hero">
        <div class="cr-hero-inner">
          <div class="ln-kicker">客户开发报告 · 2026-08-05</div>
          <h1 class="cr-title">美国灯具（HS 9405）<br />进口市场分析与开发方案</h1>
          <p class="cr-sub">数据窗口：2025-08-05 ~ 2026-08-05 ｜ 分析人：周澈（海关数据顾问）</p>
          <div class="cr-badges">
            <span>年进口额 <b>$21.5 亿</b></span>
            <span>活跃采购商 <b>14,594 家</b></span>
            <span>中国供应商 <b>9,283 家</b></span>
            <span>黄金开发窗口 <b>9-11 月</b></span>
          </div>
        </div>
      </section>

      <!-- 一、市场规模 -->
      <section class="ln-section ln-reveal">
        <div class="ln-section-head">
          <h2 class="ln-section-title">一、市场规模（概览）</h2>
          <div class="ln-section-meta">HS 9405 全品类</div>
        </div>
        <div class="cr-metrics">
          <div class="cr-metric"><b>$21.5 亿</b><span>年进口总额（sum_amount = $2,151,573,745）</span></div>
          <div class="cr-metric"><b>14,594 家</b><span>活跃采购商</span></div>
          <div class="cr-metric"><b>3,329 万条</b><span>全量交易记录（含明细）</span></div>
        </div>
        <p class="cr-note">HS 9405 主要子类：枝形吊灯（940510/511/519）、台灯/床头灯/落地灯（940520/521/529）、LED 灯泡/灯带（940542）、装饰灯（940539）、灯具零件（940599）。</p>
      </section>

      <!-- 二、头部采购商 -->
      <section class="ln-section ln-reveal">
        <div class="ln-section-head">
          <h2 class="ln-section-title">二、头部采购商 Top 10</h2>
          <div class="ln-section-meta">按交易次数排名</div>
        </div>
        <div class="cr-table-wrap">
          <table class="cr-table">
            <thead>
              <tr><th>排名</th><th>采购商</th><th>交易次数</th><th>占比</th><th>类型</th></tr>
            </thead>
            <tbody>
              {topBuyers.map((row) => (
                <tr><td class="cr-rank">{row[0]}</td><td class="cr-name">{row[1]}</td><td>{row[2]}</td><td>{row[3]}</td><td>{row[4]}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="cr-insight">
          <b>解读：</b>Top 10 中多数为香港/澳门离岸贸易公司（代理进口），真正美国本土终端买家为 <b>LG SOURCING（LG 美国采购公司）</b> 和 <b>HOME DEPOT</b>。头部集中度低（Top1 仅 4.23%），市场分散，新供应商有进入空间。
        </div>
      </section>

      <!-- 三、供应国竞争格局 -->
      <section class="ln-section ln-reveal">
        <div class="ln-section-head">
          <h2 class="ln-section-title">三、供应国竞争格局</h2>
          <div class="ln-section-meta">按单据量占比</div>
        </div>
        <div class="cr-table-wrap">
          <table class="cr-table">
            <thead>
              <tr><th>供应国</th><th>单据数</th><th>占比</th><th>出口商家数</th></tr>
            </thead>
            <tbody>
              {supplyCountries.map((row) => (
                <tr><td class="cr-name">{row[0]}</td><td>{row[1]}</td><td class={row[2] === "66.84%" ? "cr-hl" : ""}>{row[2]}</td><td>{row[3]}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="cr-insight">
          <b>关键信号：</b>
          <ul>
            <li>按单据量越南占 <b>66.84%</b>，但中国出口商数量最多（<b>9,283 家</b>），说明大量中国灯具经<strong>越南设厂/转口</strong>进入美国以规避关税；</li>
            <li>对美出口主流仍是亚洲供应链，中国工厂的直接出口份额已明显被越南挤占，<strong>报价与产地策略需重新设计</strong>。</li>
          </ul>
        </div>
      </section>

      <!-- 四、月度趋势 -->
      <section class="ln-section ln-reveal">
        <div class="ln-section-head">
          <h2 class="ln-section-title">四、月度趋势与旺季</h2>
          <div class="ln-section-meta">采购前置期 4-6 个月</div>
        </div>
        <div class="cr-trend">
          <div class="cr-trend-item cr-trend-peak">
            <b>峰值月：3-4 月</b>
            <span>45,703 / 45,529 单</span>
            <em>春季新品备货</em>
          </div>
          <div class="cr-trend-item">
            <b>次级旺季：8-12 月</b>
            <span>22,219 ~ 28,588 单</span>
            <em>圣诞季备货</em>
          </div>
          <div class="cr-trend-item cr-trend-low">
            <b>低谷：6-7 月</b>
            <span>17,548 单</span>
            <em>数据截止 2026-07-09</em>
          </div>
        </div>
        <div class="cr-insight">
          <b>结论：</b>灯具采购前置期约 4-6 个月，<strong>每年 9-11 月是开发次年春季订单的窗口，3-5 月是开发圣诞订单的窗口</strong>。
        </div>
      </section>

      <!-- 五、重点买家深挖 -->
      <section class="ln-section ln-reveal">
        <div class="ln-section-head">
          <h2 class="ln-section-title">五、重点买家深挖</h2>
          <div class="ln-section-meta">三张大客户画像</div>
        </div>
        <div class="cr-buyer-grid">
          <div class="cr-buyer">
            <b>HOME DEPOT, U. S. A., INC</b>
            <span class="cr-tag">家得宝 · 零售巨头</span>
            <ul>
              <li>月采购 569 次，年采购额 <b>$313,619,374（3.14 亿美元）</b></li>
              <li>历史记录 13,651 条</li>
              <li>近期灯具采购主要来自越南（AUROLITE ELECTRICAL、DUC VY TECHNOLOGY）</li>
            </ul>
            <p class="cr-judge">采购体量巨大，但灯具订单已明显转移越南，切入需越南产地或差异化产品。</p>
          </div>
          <div class="cr-buyer">
            <b>LG SOURCING, INC</b>
            <span class="cr-tag">LG 美国采购</span>
            <ul>
              <li>月采购 652 次，年采购额 <b>$15,971,257（1,597 万美元）</b></li>
              <li>历史记录 15,660 条</li>
              <li>集中在 C9 圣诞灯串（HS 940539），主力供应商 KWANG TA ELECTRIC PHILS（菲律宾）</li>
            </ul>
            <p class="cr-judge">圣诞灯串类大买家，可凭成本与交期优势竞争，注意 UL 认证。</p>
          </div>
          <div class="cr-buyer">
            <b>SIGNIFY NORTH AMERICA CORP</b>
            <span class="cr-tag">昕诺飞/飞利浦北美</span>
            <ul>
              <li>近期从中国 JIANGXI KLITE LIGHTING 采购 LED 灯泡</li>
              <li>单批 4,240 箱</li>
              <li>仍在从中国直接采购 LED 灯泡的头部品牌</li>
            </ul>
            <p class="cr-judge">LED 光源类中国工厂可直接接触的优质大客户。</p>
          </div>
        </div>
      </section>

      <!-- 六、近期活跃买家 -->
      <section class="ln-section ln-reveal">
        <div class="ln-section-head">
          <h2 class="ln-section-title">六、近期中国 → 美国灯具买家名单</h2>
          <div class="ln-section-meta">2026-05 ~ 08 活跃，可直接开发</div>
        </div>
        <div class="cr-table-wrap">
          <table class="cr-table">
            <thead>
              <tr><th>买家</th><th>采购品类</th><th>说明</th></tr>
            </thead>
            <tbody>
              {hotBuyers.map((row) => (
                <tr><td class="cr-name">{row[0]}</td><td>{row[1]}</td><td>{row[2]}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- 七、开发方案 -->
      <section class="ln-section ln-reveal">
        <div class="ln-section-head">
          <h2 class="ln-section-title">七、开发方案（基于数据）</h2>
          <div class="ln-section-meta">分层打法 + 合规 + 时机</div>
        </div>

        <div class="cr-layer">
          <h3><span class="cr-layer-badge cr-a">A 类</span>高价值直客，现有中国采购</h3>
          <p>SIGNIFY NORTH AMERICA、THE UTTERMOST CO、MCGEE CO PARTNER LLC —— 已有中国供应链记录，<b>报价 + 认证齐备即可切入</b>。</p>
        </div>
        <div class="cr-layer">
          <h3><span class="cr-layer-badge cr-b">B 类</span>零售巨头，需产地策略</h3>
          <p>HOME DEPOT、LG SOURCING —— 采购量大但主供在越南/菲律宾；需评估越南/东南亚布局，或提供差异化产品（智能照明、DLC 商用照明）绕开正面竞争。</p>
        </div>
        <div class="cr-layer">
          <h3><span class="cr-layer-badge cr-c">C 类</span>中型进口商/贸易商</h3>
          <p>FANGIO、MASLA、BIOLUZ、ARCHIOLOGY、THUNDER 等 —— 单量适中、决策快，<b>适合作为首批试单客户</b>。</p>
        </div>

        <div class="cr-compliance">
          <h3>产品与合规</h3>
          <ul>
            <li>家用装饰照明（吊灯/台灯/壁灯）：<b>UL/ETL 认证</b>是入场券；陶瓷、树脂、铁艺是美式主流材质</li>
            <li>LED 光源（灯泡/灯带）：需 <b>DLC / Energy Star</b>（商用/补贴项目）</li>
            <li>节日灯串：<b>UL 588</b> 季节性装饰标准，交货集中在 6-9 月</li>
          </ul>
        </div>

        <div class="cr-timing">
          <h3>时机</h3>
          <ul>
            <li><b>9-11 月</b>：开发次年春季订单（对应 3-4 月到港高峰）</li>
            <li><b>3-5 月</b>：开发圣诞季订单（对应 8-12 月到港高峰）</li>
            <li>当前 <b>8 月</b>：正处在圣诞订单备货启动期，<b>是黄金开发窗口</b></li>
          </ul>
        </div>
      </section>

      <!-- 下一步动作 -->
      <section class="cr-next ln-reveal">
        <h2>下一步动作</h2>
        <div class="cr-next-grid">
          <div><span>01</span><b>提取决策人</b><p>对 A 类客户提取决策人联系方式 → 移交「许诺」跟进</p></div>
          <div><span>02</span><b>扩大买家池</b><p>按品类/城市搜索更多灯具进口商 → 移交「林夏」</p></div>
          <div><span>03</span><b>评估产地策略</b><p>中国工厂若需越南产地配套方案，结合产能与转口成本单独评估</p></div>
        </div>
        <p class="cr-foot">完整 20 条明细见工具输出文件 query_hs_product_*_dataarea6_cn.json</p>
      </section>
    </main>

    <style>
      .ln-report .ln-wrap { padding-top: 40px; }

      /* Hero */
      .cr-hero {
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        background: linear-gradient(135deg, #0d1b2a 0%, #1b3a5c 55%, #205375 100%);
        padding: 48px 40px 40px;
        margin-bottom: 40px;
      }
      .cr-hero .ln-kicker { color: #7dd3fc; letter-spacing: 0.12em; }
      .cr-title { font-size: 40px; line-height: 1.2; color: #fff; margin: 14px 0 10px; font-weight: 800; }
      .cr-sub { color: #b8c7d6; font-size: 14px; margin: 0 0 24px; }
      .cr-badges { display: flex; flex-wrap: wrap; gap: 10px; }
      .cr-badges span {
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.16);
        color: #dbe7f2;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 13px;
      }
      .cr-badges b { color: #7dd3fc; font-weight: 700; }

      /* Metrics */
      .cr-metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
      .cr-metric {
        background: var(--ln-card, #fff);
        border: 1px solid var(--ln-border, #e6eaf0);
        border-radius: 14px;
        padding: 18px;
      }
      .cr-metric b { display: block; font-size: 26px; color: var(--ln-accent, #1b6ef3); margin-bottom: 4px; }
      .cr-metric span { font-size: 13px; color: var(--ln-muted, #6b7280); }
      .cr-note { margin-top: 14px; font-size: 13px; color: var(--ln-muted, #6b7280); line-height: 1.7; }

      /* Table */
      .cr-table-wrap { overflow-x: auto; border: 1px solid var(--ln-border, #e6eaf0); border-radius: 14px; background: var(--ln-card, #fff); }
      .cr-table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 560px; }
      .cr-table th { text-align: left; padding: 12px 14px; background: var(--ln-bg2, #f4f6fa); font-size: 12px; color: var(--ln-muted, #6b7280); text-transform: uppercase; letter-spacing: 0.04em; border-bottom: 1px solid var(--ln-border, #e6eaf0); }
      .cr-table td { padding: 11px 14px; border-bottom: 1px solid var(--ln-border, #e6eaf0); color: var(--ln-text, #1f2937); }
      .cr-table tbody tr:last-child td { border-bottom: none; }
      .cr-table tbody tr:hover { background: var(--ln-bg2, #f4f6fa); }
      .cr-rank { font-weight: 700; color: var(--ln-accent, #1b6ef3); }
      .cr-name { font-weight: 600; }
      .cr-hl { font-weight: 700; color: #d97706; }

      /* Insight */
      .cr-insight {
        margin-top: 14px;
        background: var(--ln-bg2, #f4f6fa);
        border-left: 3px solid var(--ln-accent, #1b6ef3);
        border-radius: 0 12px 12px 0;
        padding: 14px 16px;
        font-size: 14px;
        line-height: 1.8;
        color: var(--ln-text, #1f2937);
      }
      .cr-insight ul { margin: 8px 0 0; padding-left: 20px; }
      .cr-insight li { margin-bottom: 4px; }

      /* Trend */
      .cr-trend { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
      .cr-trend-item { border: 1px solid var(--ln-border, #e6eaf0); border-radius: 14px; padding: 16px; background: var(--ln-card, #fff); }
      .cr-trend-item b { display: block; font-size: 15px; margin-bottom: 4px; }
      .cr-trend-item span { font-size: 20px; font-weight: 700; color: var(--ln-accent, #1b6ef3); }
      .cr-trend-item em { display: block; font-style: normal; font-size: 12px; color: var(--ln-muted, #6b7280); margin-top: 6px; }
      .cr-trend-peak span { color: #16a34a; }
      .cr-trend-low span { color: #9ca3af; }

      /* Buyer deep dive */
      .cr-buyer-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
      .cr-buyer {
        border: 1px solid var(--ln-border, #e6eaf0);
        border-radius: 14px;
        padding: 18px;
        background: var(--ln-card, #fff);
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .cr-buyer > b { font-size: 15px; line-height: 1.4; }
      .cr-tag { display: inline-block; align-self: flex-start; background: rgba(27,110,243,0.1); color: var(--ln-accent, #1b6ef3); font-size: 12px; padding: 3px 10px; border-radius: 999px; }
      .cr-buyer ul { margin: 0; padding-left: 18px; font-size: 13px; line-height: 1.7; color: var(--ln-muted, #6b7280); }
      .cr-judge { font-size: 13px; line-height: 1.6; color: var(--ln-text, #1f2937); background: var(--ln-bg2, #f4f6fa); border-radius: 10px; padding: 10px; margin: 0; }

      /* Layers */
      .cr-layer { border: 1px solid var(--ln-border, #e6eaf0); border-radius: 14px; padding: 16px 18px; margin-bottom: 12px; background: var(--ln-card, #fff); }
      .cr-layer h3 { display: flex; align-items: center; gap: 10px; font-size: 15px; margin: 0 0 6px; }
      .cr-layer p { margin: 0; font-size: 14px; line-height: 1.8; color: var(--ln-muted, #6b7280); }
      .cr-layer-badge { display: inline-block; font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 999px; color: #fff; }
      .cr-a { background: #16a34a; }
      .cr-b { background: #d97706; }
      .cr-c { background: #6b7280; }

      .cr-compliance, .cr-timing { margin-top: 20px; }
      .cr-compliance h3, .cr-timing h3 { font-size: 15px; margin-bottom: 8px; }
      .cr-compliance ul, .cr-timing ul { margin: 0; padding-left: 20px; font-size: 14px; line-height: 2; }

      /* Next */
      .cr-next {
        margin-top: 40px;
        border-radius: 20px;
        background: linear-gradient(135deg, #0d1b2a 0%, #1b3a5c 100%);
        padding: 36px;
        color: #fff;
      }
      .cr-next h2 { font-size: 24px; margin: 0 0 20px; }
      .cr-next-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
      .cr-next-grid > div { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.14); border-radius: 14px; padding: 16px; }
      .cr-next-grid span { font-size: 12px; color: #7dd3fc; font-weight: 700; }
      .cr-next-grid b { display: block; font-size: 15px; margin: 6px 0; }
      .cr-next-grid p { margin: 0; font-size: 13px; line-height: 1.7; color: #c6d5e3; }
      .cr-foot { margin: 20px 0 0; font-size: 12px; color: #8fa3b5; }

      @media (max-width: 900px) {
        .cr-metrics, .cr-trend, .cr-buyer-grid, .cr-next-grid { grid-template-columns: 1fr; }
        .cr-hero { padding: 32px 24px; }
        .cr-title { font-size: 30px; }
      }
    </style>
  </body>
