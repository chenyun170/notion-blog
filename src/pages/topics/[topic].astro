---
import "../../styles/linear.css";
import { getPosts } from "../../lib/notion";
import { getTopicBySlug, postMatchesTopic, TOPICS } from "../../lib/topics";
import SeoHead from "../../components/SeoHead.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from "../../consts";

export const prerender = false;
export const revalidate = 3600; // ISR: 每 1 小时重新验证
const MIN_INDEXABLE_ARCHIVE_POSTS = 3;

const topic = getTopicBySlug(Astro.params.topic);

if (!topic) {
  return new Response("Not Found", { status: 404 });
}

const posts = (await getPosts())
  .filter((post) => postMatchesTopic(post, topic))
  .sort((a, b) => {
    const ad = a.date ? new Date(a.date).getTime() : -Infinity;
    const bd = b.date ? new Date(b.date).getTime() : -Infinity;
    return bd - ad;
  });

const canonicalURL = new URL(`/topics/${topic.slug}`, SITE_URL).toString();
const pageTitle = `${topic.name} | ${SITE_TITLE}`;
const pageDescription = `${topic.desc}。${SITE_DESCRIPTION}`;
const shouldIndex = posts.length >= MIN_INDEXABLE_ARCHIVE_POSTS;
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: pageTitle,
  description: pageDescription,
  url: canonicalURL,
  inLanguage: "zh-CN",
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: posts.length,
    itemListElement: posts.slice(0, 20).map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/posts/${post.slug}`, SITE_URL).toString(),
      name: post.title,
      description: post.summary || post.title,
    })),
  },
};
---

<html lang="zh-CN">
  <head>
    <SeoHead
      title={pageTitle}
      description={pageDescription}
      canonical={canonicalURL}
      robots={shouldIndex ? "index, follow" : "noindex, follow"}
      structuredData={collectionSchema}
    />
  </head>
  <body class="ln ln-home">
    <SiteHeader context="专题" />

    <main class="ln-wrap">
      <section class="ln-hero ln-hero-glass ln-hero-compact ln-reveal">
        <div class="ln-kicker">专题 · {posts.length} 篇文章</div>
        <h1 class="ln-h1">{topic.name}</h1>
        <p class="ln-sub">{topic.desc}。这里整理与「{topic.name}」相关的外贸实战文章、工具笔记和数据分析。</p>
      </section>

      <section class="ln-glass ln-reveal" aria-label="专题文章">
        <div class="ln-glass-head">
          <div>
            <div class="ln-glass-title">相关文章</div>
            <div class="ln-glass-meta">共 {posts.length} 篇</div>
          </div>
          <a class="ln-chip" href="/">返回首页</a>
        </div>

        {posts.length ? (
          <div class="ln-card-grid">
            {posts.map((post) => (
              <a class="ln-card" href={`/posts/${post.slug}`}>
                <span class="ln-card-media">
                  {post.cover ? (
                    <img src={post.cover} alt={post.title} width="360" height="220" loading="lazy" decoding="async" />
                  ) : (
                    <span class="ln-card-fallback" aria-hidden="true">阅读</span>
                  )}
                  <span class="ln-card-overlay" aria-hidden="true"></span>
                  <span class="ln-card-badges">
                    <span class="ln-card-badge">{post.date || "最新"}</span>
                    {(post.tags?.length ?? 0) > 0 ? <span class="ln-card-badge">{post.tags.slice(0, 1)[0]}</span> : null}
                  </span>
                </span>
                <span class="ln-card-body">
                  <span class="ln-card-title">{post.title}</span>
                  <span class="ln-card-summary">{post.summary || "围绕外贸客户开发、数据分析和工具实战的文章笔记。"}</span>
                </span>
              </a>
            ))}
          </div>
        ) : (
          <div class="ln-empty">
            <div class="ln-empty-title">暂无文章</div>
            <div class="ln-empty-sub">这个主题暂时没有匹配文章，后续发布后会自动出现在这里。</div>
          </div>
        )}
      </section>

      <section class="ln-section ln-reveal" aria-label="全部专题">
        <div class="ln-section-head">
          <h2 class="ln-section-title">全部专题</h2>
          <div class="ln-section-meta">按方向浏览</div>
        </div>
        <div class="ln-topic-grid">
          {TOPICS.map((item) => (
            <a class={`ln-topic${item.slug === topic.slug ? " active" : ""}`} href={`/topics/${item.slug}`}>
              <span class="ln-topic-name">{item.name}</span>
              <span class="ln-topic-desc">{item.desc}</span>
            </a>
          ))}
        </div>
      </section>

      <footer class="ln-foot ln-reveal">
        <span>© {new Date().getFullYear()} {SITE_TITLE}</span>
        <span class="ln-dot">·</span>
        <a class="ln-navlink" href="/">返回首页</a>
      </footer>
    </main>

    <script is:inline>
      const root = document.documentElement;
      const key = "theme";
      const saved = localStorage.getItem(key);
      const btn = document.getElementById("themeToggle");
      if (saved === "dark") { root.classList.add("dark"); if (btn) btn.textContent = "🌙"; }
      if (saved === "light") { root.classList.remove("dark"); if (btn) btn.textContent = "☀️"; }
      btn?.addEventListener("click", () => {
        root.classList.toggle("dark");
        btn.textContent = root.classList.contains("dark") ? "🌙" : "☀️";
        localStorage.setItem(key, root.classList.contains("dark") ? "dark" : "light");
      });
    </script>
  </body>
</html>
